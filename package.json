{
  "name": "flashcards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open --port 3000",
    "build": "tsc && vite build",
    "format": "prettier --write src",
    "lint": "eslint src --ext .jsx,.js,.tsx,.ts  --no-error-on-unmatched-pattern --fix && stylelint --fix src/{,*/}*.{scss,css} --allow-empty-input",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "rename-icons": "node generators/icons/rename-icons.cjs",
    "replace-colors": "node generators/icons/replace-colors.cjs",
    "generate-icons": "pnpm run rename-icons && npx @svgr/cli --out-dir src/assets/icons/components --jsx-runtime automatic --typescript --ref --memo --no-dimensions --replace-attr-values '#000=currentcolor' -- src/assets/icons/svg && echo \"Successfully executed\" || echo \"Execution failed\" && pnpm run format && pnpm run lint  "
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "5.0.12",
    "@hookform/resolvers": "3.4.2",
    "@mui/material": "^7.1.2",
    "@radix-ui/react-avatar": "1.0.4",
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "2.0.6",
    "@radix-ui/react-icons": "1.3.0",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "1.0.7",
    "@reduxjs/toolkit": "^2.3.0",
    "@storybook/addons": "7.6.17",
    "framer-motion": "11.1.9",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.51.5",
    "react-redux": "^9.1.2",
    "react-router-dom": "6.23.1",
    "react-toastify": "^11.0.5",
    "storybook-addon-react-router-v6": "1.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@hookform/devtools": "4.3.1",
    "@it-incubator/eslint-config": "1.0.2",
    "@it-incubator/prettier-config": "0.1.2",
    "@it-incubator/stylelint-config": "1.0.3",
    "@storybook/addon-actions": "8.0.9",
    "@storybook/addon-essentials": "8.0.9",
    "@storybook/addon-interactions": "8.0.9",
    "@storybook/addon-links": "8.0.9",
    "@storybook/addon-onboarding": "8.0.9",
    "@storybook/blocks": "8.0.9",
    "@storybook/manager-api": "^8.2.2",
    "@storybook/react": "8.0.9",
    "@storybook/react-vite": "8.0.9",
    "@storybook/test": "8.0.9",
    "@storybook/theming": "8.0.9",
    "@types/node": "20.12.2",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "@vitejs/plugin-react-swc": "3.5.0",
    "clsx": "2.1.0",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.6",
    "eslint-plugin-storybook": "0.8.0",
    "sass": "1.72.0",
    "storybook": "8.0.9",
    "storybook-addon-styled-component-theme": "2.0.0",
    "storybook-dark-mode": "4.0.1",
    "stylelint": "16.3.1",
    "stylelint-config-recommended-scss": "14.0.0",
    "typescript": "5.2.2",
    "vite": "5.2.0"
  }
}
